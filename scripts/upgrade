#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

upstream_version=$(ynh_read_manifest "version" | cut -d'~' -f1)

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop"

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_app_setting_set_default --key=rag_embedding_engine --value="ollama"
ynh_app_setting_set_default --key=ollama_base_url --value="http://127.0.0.1:11434"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================

ynh_setup_source --dest_dir="$install_dir" --keep="venv"

pushd "$install_dir"
 venv/bin/pip install --upgrade pip setuptools wheel
 venv/bin/pip install open-webui=="$upstream_version"
popd

chown -R "$app:www-data" "$install_dir"

#=================================================
# REAPPLY SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add --template=".env" --destination="$install_dir/.env"
chmod 400 "$install_dir/.env"
chown "$app:$app" "$install_dir/.env"

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="Open WebUI Slim (external LLM, no local models)" --log="/var/log/$app/$app.log"

ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --wait_until="No requirements found in frontmatter" --timeout=600

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
