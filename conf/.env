# Slim profile: external LLM mandatory, no bundled models.
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='__OLLAMA_BASE_URL__'
OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''
CORS_ALLOW_ORIGIN='https://__DOMAIN__'
FORWARDED_ALLOW_IPS='127.0.0.1'
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
DEFAULT_LOCALE=__LANGUAGE__
ADMIN_EMAIL=__MAIL__
ENV="prod"
WEBUI_NAME="Open WebUI Slim for YunoHost"
PORT=__PORT__
DATA_DIR="__DATA_DIR__"
ENABLE_SIGNUP=false
# SLIM: 'ollama' or 'openai' only. Empty (local sentence-transformers) is
# intentionally unsupported: it would download ~1GB on first start.
RAG_EMBEDDING_ENGINE=__RAG_EMBEDDING_ENGINE__
# SLIM defaults: disable heavy/online extras, keep base chat fast.
ENABLE_RAG_WEB_SEARCH=False
ENABLE_IMAGE_GENERATION=False
# Smallest Whisper model so voice input stays usable without a 500MB download.
# Set to empty only if you never use voice input.
WHISPER_MODEL=tiny
#LDAP
ENABLE_LDAP=true
LDAP_SERVER_LABEL='YunoHost LDAP'
LDAP_SERVER_HOST=127.0.0.1
LDAP_SERVER_PORT=389
LDAP_USE_TLS=false
LDAP_VALIDATE_CERT=false
LDAP_SEARCH_BASE=dc=yunohost,dc=org
LDAP_SEARCH_FILTERS=(&(|(objectclass=posixAccount))(permission=cn=open-webui-slim.main,ou=permission,dc=yunohost,dc=org))
LDAP_ATTRIBUTE_FOR_USERNAME=uid
LDAP_ATTRIBUTE_FOR_MAIL=mail
DEFAULT_USER_ROLE=user
LDAP_APP_DN=''
LDAP_APP_PASSWORD=''
